{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "pos.html",
      "use": "@vercel/static"
    },
    {
      "src": "pos.css",
      "use": "@vercel/static"
    },
    {
      "src": "pos.js",
      "use": "@vercel/static"
    },
    {
      "src": "sayur-nusantara.js",
      "use": "@vercel/static"
    },
    {
      "src": "harga.html",
      "use": "@vercel/static"
    },
    {
      "src": "harga.css",
      "use": "@vercel/static"
    },
    {
      "src": "harga.js",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "icons/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/icons/$1"
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "/manifest.webmanifest"
    },
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Service-Worker-Allowed": "/"
      },
      "dest": "/sw.js"
    },
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/script.js",
      "dest": "/script.js"
    },
    {
      "src": "/sayur-nusantara.js",
      "dest": "/sayur-nusantara.js"
    },
    {
      "src": "/pos",
      "dest": "/pos.html"
    },
    {
      "src": "/pos/",
      "dest": "/pos.html"
    },
    {
      "src": "/pos.html",
      "dest": "/pos.html"
    },
    {
      "src": "/pos.css",
      "dest": "/pos.css"
    },
    {
      "src": "/pos.js",
      "dest": "/pos.js"
    },
    {
      "src": "/harga",
      "dest": "/harga.html"
    },
    {
      "src": "/harga/",
      "dest": "/harga.html"
    },
    {
      "src": "/harga.html",
      "dest": "/harga.html"
    },
    {
      "src": "/harga.css",
      "dest": "/harga.css"
    },
    {
      "src": "/harga.js",
      "dest": "/harga.js"
    },
    {
      "src": "/dashboard",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
