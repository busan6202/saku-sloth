{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "pos.html",
      "use": "@vercel/static"
    },
    {
      "src": "pos.css",
      "use": "@vercel/static"
    },
    {
      "src": "pos.js",
      "use": "@vercel/static"
    },
    {
      "src": "icons/*.svg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/icons/$1"
    },
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/script.js",
      "dest": "/script.js"
    },
    {
      "src": "/pos",
      "dest": "/pos.html"
    },
    {
      "src": "/pos.html",
      "dest": "/pos.html"
    },
    {
      "src": "/pos.css",
      "dest": "/pos.css"
    },
    {
      "src": "/pos.js",
      "dest": "/pos.js"
    },
    {
      "src": "/dashboard",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
